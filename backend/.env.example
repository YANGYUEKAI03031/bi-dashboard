# MySQL数据库设置
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your-password-here
MYSQL_DATABASE=users

# Security settings
# 生成方式: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Encryption key for sensitive data (Fernet AES-128-CBC)
# 生成方式: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your-encryption-key-here

# CORS settings - 支持多个域名，逗号分隔
# 本地开发: ["http://localhost:3000","http://127.0.0.1:3000"]
# 生产部署: ["http://your-domain.com","https://your-domain.com"]
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Environment mode: local / production
ENVIRONMENT=local

# Application settings
PROJECT_NAME=BI Dashboard API
PROJECT_VERSION=1.0.0
DEBUG=True

# 生产环境配置（取消注释并修改）
# PRODUCTION_DOMAIN=http://your-domain.com
# REDIS_PASSWORD=your-redis-password
